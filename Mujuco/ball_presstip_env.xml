<mujoco model="ball_on_sensor">
  <compiler angle="degree" coordinate="local"/>
  <option gravity="0 0 -9.81" timestep="0.002"/>

  <default>
    <geom type="box" size="0.02 0.02 0.005"
          rgba="0.2 0.6 0.8 1"
          condim="3"
          friction="1 0.005 0.0001"/>
  </default>

  <worldbody>
    <!-- Ground -->
    <geom name="ground" type="plane" size="1 1 0.1" rgba="0.9 0.9 0.9 1"/>

    <!-- Include sensor pad array -->
    <include file="presstip_foot.xml"/>

    <!-- Ball / probe -->
    <body name="probe" pos="0 0 0.2">
      <joint type="free"/>
      <geom type="sphere" size="0.03" rgba="0.8 0.2 0.2 1" mass="0.5"/>
    </body>
  </worldbody>
</mujoco>